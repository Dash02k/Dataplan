<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Service Plans</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      padding: 20px;
      background-color: #f8f9fa;
      color: #333;
    }
    .container {
      max-width: 500px;
      margin: 0 auto;
      background: #ffffff;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .header-box {
      text-align: center;
      background-color: #eef2f7;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      line-height: 1.5;
    }
    .card-grid {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    .plan-card {
      background-color: #2c3e50;
      color: #ffffff;
      padding: 20px;
      border-radius: 10px;
      position: relative;
      text-align: center;
    }
    .badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background-color: rgba(255,255,255,0.2);
      padding: 4px 8px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
    }
    .plan-title {
      font-size: 24px;
      font-weight: bold;
      margin: 15px 0 5px 0;
    }
    .plan-duration {
      font-size: 14px;
      opacity: 0.8;
      margin-bottom: 20px;
    }
    .plan-price {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 15px;
    }
    .action-btn {
      display: inline-block;
      color: #ffffff;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      border-bottom: 1px dashed rgba(255,255,255,0.6);
      padding-bottom: 2px;
    }
    .action-btn:hover {
      opacity: 0.8;
    }
  </style>
</head>
<body>

<div class="container">
  <div class="header-box">
    <strong>Available Service Packages</strong><br>
    Select an option below to continue to checkout.
  </div>

  <div class="card-grid">
    <!-- Card 1 -->
    <div class="plan-card">
      <span class="badge">Promo</span>
      <div class="plan-title">Basic Plan</div>
      <div class="plan-duration">2-Day Duration</div>
      <div class="plan-price">Free Trial</div>
      <a href="#" class="action-btn">View details &rarr;</a>
    </div>

    <!-- Card 2 -->
    <div class="plan-card">
      <span class="badge">Popular</span>
      <div class="plan-title">Standard Plan</div>
      <div class="plan-duration">7-Day Duration</div>
      <div class="plan-price">$0.99</div>
      <a href="#" class="action-btn">View details &rarr;</a>
    </div>
  </div>
</div>

</body>
</html>
